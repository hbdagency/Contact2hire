# SMTP settings used by the contact form (/api/contact)
# Gmail example: host smtp.gmail.com, port 587, user your@gmail.com,
# pass an "App Password" (https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_SECURE=false

# Where form submissions are delivered (defaults to info@contacttohire.in)
EMAIL_TO=info@contacttohire.in
