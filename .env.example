# ---------------------------------------------------------------------------
# Contact form delivery (/api/contact)
# ---------------------------------------------------------------------------

# 1) Email — every submission is emailed here via SMTP (nodemailer).
#    Gmail example: host smtp.gmail.com, port 587, user your@gmail.com,
#    pass an "App Password" (https://myaccount.google.com/apppasswords)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_SECURE=false

# Where submissions are emailed (defaults to info@contacttohire.in)
EMAIL_TO=info@contacttohire.in

# 2) Google Sheets (optional) — every submission is also appended as a row.
#    Easiest method: no Google Cloud project or API keys. Paste
#    scripts/sheets-apps-script.gs into your sheet's Apps Script editor,
#    deploy it as a Web app ("Anyone"), and set the /exec URL here.
SHEETS_WEBHOOK_URL=

# 3) Spam protection — a hidden honeypot field is always active. Optionally
#    cap submissions per IP per window (in-memory; resets on restart).
#    Set CONTACT_RATE_LIMIT=0 to disable rate limiting.
CONTACT_RATE_LIMIT=3
CONTACT_RATE_WINDOW_MINUTES=60
